{
  "name": "@justanarthur/modo-ui",
  "type": "module",
  "version": "0.3.0",
  "description": "Fluid Functionalism (Base UI flavor, MIT © 2026 Micka Touillaud) ported to UnoCSS: motion springs, fluid hover, a two-step size ladder and an eight-level elevated surface system. Documented with modo.",
  "license": "MIT",
  "keywords": [
    "design-system",
    "react",
    "components",
    "base-ui",
    "unocss",
    "tailwindcss",
    "motion",
    "fluid-functionalism"
  ],
  "homepage": "https://github.com/justAnArthur/modo/tree/main/ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/justAnArthur/modo.git",
    "directory": "ui"
  },
  "bugs": {
    "url": "https://github.com/justAnArthur/modo/issues"
  },
  "author": {
    "name": "justAnArthur",
    "email": "kozubov.arthur@gmail.com"
  },
  "properties": {
    "gitCommitScopeRelatedNames": "ui,modo-ui,@justanarthur/modo-ui,justanarthur/modo-ui"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE*"
  ],
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./primitives/*": {
      "types": "./dist/primitives/*/index.d.ts",
      "default": "./dist/primitives/*/index.js"
    },
    "./components/*": {
      "types": "./dist/components/*/index.d.ts",
      "default": "./dist/components/*/index.js"
    },
    "./blocks/*": {
      "types": "./dist/blocks/*/index.d.ts",
      "default": "./dist/blocks/*/index.js"
    },
    "./unocss": {
      "types": "./dist/preset.d.ts",
      "default": "./dist/preset.js"
    },
    "./styles.css": "./dist/styles.css",
    "./base.css": "./dist/base.css",
    "./tokens.css": "./dist/tokens.css",
    "./tailwind.css": "./dist/tailwind.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && NODE_ENV=production bunup && bun scripts/build-css.ts",
    "build:docs": "modo build --out docs-dist",
    "dev": "modo dev",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "1.4.1",
    "@fontsource-variable/inter": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.47.0",
    "motion": "^13.4.0",
    "pdfjs-dist": "^5.7.284",
    "react-day-picker": "^10.0.2",
    "sugar-high": "^2.5.1"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@justanarthur/modo": "workspace:*",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "bunup": "^0.16.0",
    "esbuild": "^0.20.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "typescript": "^5.4.0",
    "unocss": "66.10.5",
    "vite": "^5.4.0"
  }
}