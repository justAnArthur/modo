{
  "name": "modo-atomic-ui",
  "description": "Atomic design system renderer — enforces the tokens/primitives/components/blocks structure and auto-renders the docs.",
  "version": "0.0.0",
  "type": "module",
  "files": [
    "dist",
    "src/runtime",
    "src/exports",
    "templates",
    "README.md"
  ],
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./schema": {
      "import": {
        "types": "./dist/schema.d.ts",
        "default": "./dist/schema.js"
      }
    },
    "./tsdoc": {
      "import": {
        "types": "./dist/tsdoc.d.ts",
        "default": "./dist/tsdoc.js"
      }
    },
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./config": {
      "import": {
        "types": "./dist/config.d.ts",
        "default": "./dist/config.js"
      }
    },
    "./check": {
      "import": {
        "types": "./dist/check.d.ts",
        "default": "./dist/check.js"
      }
    },
    "./surfaces-runtime": {
      "import": {
        "types": "./dist/surfaces-runtime.d.ts",
        "default": "./dist/surfaces-runtime.js"
      }
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "modo": "./dist/cli.js"
  },
  "scripts": {
    "build": "NODE_ENV=production bunup",
    "build:runtime": "vike build --root src/runtime",
    "dev": "vite --config src/runtime/vite.config.ts",
    "check": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "vike": "^0.4.260",
    "vike-react": "^0.6.25",
    "vite": "^7.3.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@babel/preset-typescript": "^8.0.1",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "bunup": "^0.16.32",
    "esbuild": "^0.28.1",
    "typescript": "^5.9.3"
  }
}
