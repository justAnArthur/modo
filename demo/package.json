{
  "name": "@modo/demo",
  "type": "module",
  "private": true,
  "version": "0.1.0",
  "description": "demo harness: multi-design-system runner + demo-switcher. each design system lives in design-systems/<name> as its own workspace package.",
  "scripts": {
    "dev": "bun scripts/run-design-systems.ts",
    "samples:filled": "bun scripts/run-design-systems.ts filled",
    "samples:shadcn": "bun scripts/run-design-systems.ts shadcn",
    "samples:fluid-functionalism": "bun scripts/run-design-systems.ts fluid-functionalism",
    "samples:mui": "bun scripts/run-design-systems.ts mui",
    "build": "modo build",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@justanarthur/modo": "workspace:*",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "typescript": "^5.4.0"
  }
}
