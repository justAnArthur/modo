{
  "name": "@justanarthur/modo",
  "type": "module",
  "version": "0.2.0-beta.2",
  "description": "Atomic design system renderer — reads tokens/primitives/components/blocks and produces a docs site that uses the user's components in the chrome.",
  "license": "MIT",
  "keywords": [
    "design-system",
    "atomic-design",
    "design-tokens",
    "renderer",
    "documentation",
    "react",
    "vite",
    "primitives",
    "components",
    "blocks"
  ],
  "homepage": "https://github.com/justAnArthur/modo#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/justAnArthur/modo.git"
  },
  "bugs": {
    "url": "https://github.com/justAnArthur/modo/issues"
  },
  "author": {
    "name": "justAnArthur",
    "email": "kozubov.arthur@gmail.com"
  },
  "properties": {
    "gitCommitScopeRelatedNames": "lib,modo,justanarthur,@justanarthur/modo,justanarthur/modo"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "files": [
    "dist",
    "src/runtime",
    "src/lib",
    "src/plugins",
    "src/exports",
    "templates",
    "README.md"
  ],
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./config": {
      "import": {
        "types": "./dist/config.d.ts",
        "default": "./dist/config.js"
      }
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "modo": "./dist/cli.js"
  },
  "scripts": {
    "build": "bunup",
    "dev": "vite --config src/runtime/vite.config.ts",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@babel/standalone": "^7.24.0",
    "esbuild": "^0.20.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/babel__standalone": "^7.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "bunup": "^0.16.0",
    "typescript": "^5.4.0",
    "vite": "^5.4.0"
  }
}