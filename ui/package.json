{
  "name": "@justanarthur/modo-ui",
  "type": "module",
  "version": "0.6.0",
  "description": "Fluid Functionalism (Base UI flavor, MIT © 2026 Micka Touillaud) ported to UnoCSS: motion springs, fluid hover, a two-step size ladder and an eight-level elevated surface system. Documented with modo.",
  "license": "MIT",
  "keywords": [
    "design-system",
    "react",
    "components",
    "base-ui",
    "unocss",
    "tailwindcss",
    "motion",
    "fluid-functionalism"
  ],
  "homepage": "https://github.com/justAnArthur/modo/tree/main/ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/justAnArthur/modo.git",
    "directory": "ui"
  },
  "bugs": {
    "url": "https://github.com/justAnArthur/modo/issues"
  },
  "author": {
    "name": "justAnArthur",
    "email": "kozubov.arthur@gmail.com"
  },
  "properties": {
    "gitCommitScopeRelatedNames": "ui,modo-ui,@justanarthur/modo-ui,justanarthur/modo-ui"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "files": [
    "dist",
    "index.ts",
    "lib/*.ts",
    "lib/*.tsx",
    "primitives",
    "components",
    "blocks",
    "README.md",
    "LICENSE*"
  ],
  "engines": {
    "node": ">=20"
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "source": "./index.ts",
      "default": "./dist/index.js"
    },
    "./primitives/*": {
      "types": "./dist/primitives/*/index.d.ts",
      "source": "./primitives/*/index.tsx",
      "default": "./dist/primitives/*/index.js"
    },
    "./components/*/variants": {
      "types": "./dist/components/*/variants.d.ts",
      "source": "./components/*/variants.ts",
      "default": "./dist/components/*/variants.js"
    },
    "./components/*": {
      "types": "./dist/components/*/index.d.ts",
      "source": "./components/*/index.tsx",
      "default": "./dist/components/*/index.js"
    },
    "./blocks/*": {
      "types": "./dist/blocks/*/index.d.ts",
      "source": "./blocks/*/index.tsx",
      "default": "./dist/blocks/*/index.js"
    },
    "./lib/utils": {
      "types": "./dist/lib/utils.d.ts",
      "source": "./lib/utils.ts",
      "default": "./dist/lib/utils.js"
    },
    "./lib/springs": {
      "types": "./dist/lib/springs.d.ts",
      "source": "./lib/springs.ts",
      "default": "./dist/lib/springs.js"
    },
    "./lib/size-scale": {
      "types": "./dist/lib/size-scale.d.ts",
      "source": "./lib/size-scale.ts",
      "default": "./dist/lib/size-scale.js"
    },
    "./lib/shape-classes": {
      "types": "./dist/lib/shape-classes.d.ts",
      "source": "./lib/shape-classes.ts",
      "default": "./dist/lib/shape-classes.js"
    },
    "./lib/field-classes": {
      "types": "./dist/lib/field-classes.d.ts",
      "source": "./lib/field-classes.ts",
      "default": "./dist/lib/field-classes.js"
    },
    "./lib/field-box": {
      "types": "./dist/lib/field-box.d.ts",
      "source": "./lib/field-box.ts",
      "default": "./dist/lib/field-box.js"
    },
    "./lib/size-context": {
      "types": "./dist/lib/size-context.d.ts",
      "source": "./lib/size-context.tsx",
      "default": "./dist/lib/size-context.js"
    },
    "./lib/shape-context": {
      "types": "./dist/lib/shape-context.d.ts",
      "source": "./lib/shape-context.tsx",
      "default": "./dist/lib/shape-context.js"
    },
    "./lib/icon-context": {
      "types": "./dist/lib/icon-context.d.ts",
      "source": "./lib/icon-context.tsx",
      "default": "./dist/lib/icon-context.js"
    },
    "./lib/use-controllable-state": {
      "types": "./dist/lib/use-controllable-state.d.ts",
      "source": "./lib/use-controllable-state.ts",
      "default": "./dist/lib/use-controllable-state.js"
    },
    "./lib/use-morph": {
      "types": "./dist/lib/use-morph.d.ts",
      "source": "./lib/use-morph.ts",
      "default": "./dist/lib/use-morph.js"
    },
    "./lib/goo-indicator": {
      "types": "./dist/lib/goo-indicator.d.ts",
      "source": "./lib/goo-indicator.tsx",
      "default": "./dist/lib/goo-indicator.js"
    },
    "./unocss": {
      "types": "./dist/preset.d.ts",
      "default": "./dist/preset.js"
    },
    "./styles.css": "./dist/styles.css",
    "./base.css": "./dist/base.css",
    "./tokens.css": "./dist/tokens.css",
    "./tailwind.css": "./dist/tailwind.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && NODE_ENV=production bunup && bun scripts/build-css.ts",
    "build:docs": "modo build --out docs-dist",
    "dev": "modo dev",
    "check": "tsc --noEmit",
    "check:dist": "bun scripts/check-dist.ts",
    "test": "bun test"
  },
  "dependencies": {
    "@base-ui/react": "1.4.1",
    "@fontsource-variable/inter": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.47.0",
    "motion": "^13.4.0",
    "react-day-picker": "^10.0.2",
    "sugar-high": "^2.5.1"
  },
  "peerDependencies": {
    "pdfjs-dist": "^5.7.284",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "pdfjs-dist": {
      "optional": true
    }
  },
  "devDependencies": {
    "@justanarthur/modo": "workspace:*",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "bunup": "^0.16.0",
    "esbuild": "^0.28.2",
    "pdfjs-dist": "^5.7.284",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "typescript": "^5.4.0",
    "unocss": "66.10.5",
    "vite": "^8.3.8"
  }
}
