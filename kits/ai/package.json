{
  "name": "@justanarthur/modo-ui-ai",
  "type": "module",
  "version": "0.1.0",
  "description": "An AI agent app kit on modo-ui: messages, tool calls, prompts, a composer, a transcript, side panes, settings and full app screens. Documented with modo.",
  "license": "MIT",
  "keywords": [
    "design-system",
    "react",
    "components",
    "ai",
    "agent",
    "chat",
    "modo-ui"
  ],
  "homepage": "https://justanarthur.github.io/modo/ai/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/justAnArthur/modo.git",
    "directory": "kits/ai"
  },
  "bugs": {
    "url": "https://github.com/justAnArthur/modo/issues"
  },
  "author": {
    "name": "justAnArthur",
    "email": "kozubov.arthur@gmail.com"
  },
  "properties": {
    "gitCommitScopeRelatedNames": "ai,modo-ui-ai,@justanarthur/modo-ui-ai,justanarthur/modo-ui-ai"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "files": [
    "dist",
    "index.ts",
    "lib/*.ts",
    "lib/*.tsx",
    "components",
    "blocks",
    "mock",
    "README.md",
    "LICENSE*"
  ],
  "engines": {
    "node": ">=20"
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "source": "./index.ts",
      "default": "./dist/index.js"
    },
    "./components/*": {
      "types": "./dist/components/*/index.d.ts",
      "source": "./components/*/index.tsx",
      "default": "./dist/components/*/index.js"
    },
    "./blocks/*": {
      "types": "./dist/blocks/*/index.d.ts",
      "source": "./blocks/*/index.tsx",
      "default": "./dist/blocks/*/index.js"
    },
    "./lib/icons": {
      "types": "./dist/lib/icons.d.ts",
      "source": "./lib/icons.tsx",
      "default": "./dist/lib/icons.js"
    },
    "./lib/pace": {
      "types": "./dist/lib/pace.d.ts",
      "source": "./lib/pace.ts",
      "default": "./dist/lib/pace.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && NODE_ENV=production bunup && bun scripts/build-css.ts",
    "build:docs": "modo build --out docs-dist",
    "dev": "modo dev",
    "check": "tsc --noEmit",
    "check:dist": "bun scripts/check-dist.ts"
  },
  "dependencies": {
    "lucide-react": "^1.47.0",
    "motion": "^13.4.0"
  },
  "peerDependencies": {
    "@justanarthur/modo-ui": "^2.0.0",
    "pdfjs-dist": "^5.7.284",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "pdfjs-dist": {
      "optional": true
    }
  },
  "devDependencies": {
    "@justanarthur/modo": "workspace:*",
    "@justanarthur/modo-ui": "workspace:*",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "bunup": "^0.16.0",
    "pdfjs-dist": "^5.7.284",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "typescript": "^5.4.0",
    "unocss": "66.10.5",
    "vite": "^8.3.8"
  }
}
