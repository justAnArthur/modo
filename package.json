{
  "name": "modo-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "modo — atomic design system renderer. monorepo root.",
  "type": "module",
  "workspaces": [
    "lib",
    "demo",
    "demo/design-systems/*",
    "ui"
  ],
  "scripts": {
    "build": "bun --filter '@justanarthur/modo' build && bun --filter '@justanarthur/modo-ui' build",
    "dev": "bun --filter '@modo/demo' dev",
    "check": "bun --filter '*' check",
    "test": "bun --filter '@justanarthur/modo' test",
    "lint": "biome check",
    "format": "biome check --write"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  }
}
