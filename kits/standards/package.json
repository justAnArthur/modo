{
  "name": "@justanarthur/modo-ui-standards",
  "type": "module",
  "version": "0.4.1",
  "description": "The UI of just-standards on modo-ui: every business measured against packs of standards, the grid of assets × items, and a failing cell handed to an AI worker. Documented with modo.",
  "license": "MIT",
  "keywords": [
    "design-system",
    "react",
    "components",
    "standards",
    "compliance",
    "modo-ui"
  ],
  "homepage": "https://justanarthur.github.io/modo/standards/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/justAnArthur/modo.git",
    "directory": "kits/standards"
  },
  "bugs": {
    "url": "https://github.com/justAnArthur/modo/issues"
  },
  "author": {
    "name": "justAnArthur",
    "email": "kozubov.arthur@gmail.com"
  },
  "properties": {
    "gitCommitScopeRelatedNames": "standards,modo-ui-standards,@justanarthur/modo-ui-standards,justanarthur/modo-ui-standards"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "files": [
    "dist",
    "index.ts",
    "lib/*.ts",
    "lib/*.tsx",
    "components",
    "blocks",
    "mock",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "source": "./index.ts",
      "default": "./dist/index.js"
    },
    "./components/*": {
      "types": "./dist/components/*/index.d.ts",
      "source": "./components/*/index.tsx",
      "default": "./dist/components/*/index.js"
    },
    "./blocks/*": {
      "types": "./dist/blocks/*/index.d.ts",
      "source": "./blocks/*/index.tsx",
      "default": "./dist/blocks/*/index.js"
    },
    "./lib/types": {
      "types": "./dist/lib/types.d.ts",
      "source": "./lib/types.ts",
      "default": "./dist/lib/types.js"
    },
    "./lib/cells": {
      "types": "./dist/lib/cells.d.ts",
      "source": "./lib/cells.ts",
      "default": "./dist/lib/cells.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && NODE_ENV=production bunup && bun scripts/build-css.ts",
    "build:docs": "modo build --out docs-dist",
    "dev": "modo dev",
    "check": "tsc --noEmit",
    "check:dist": "bun scripts/check-dist.ts"
  },
  "dependencies": {
    "lucide-react": "^1.47.0"
  },
  "peerDependencies": {
    "@justanarthur/modo-ui": "^2.6.0",
    "@justanarthur/modo-ui-ai": "^0.5.0",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@justanarthur/modo": "workspace:*",
    "@justanarthur/modo-ui": "workspace:*",
    "@justanarthur/modo-ui-ai": "workspace:*",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "bunup": "^0.16.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "typescript": "^5.4.0",
    "unocss": "66.10.5",
    "vite": "^8.3.8"
  }
}