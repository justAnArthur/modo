{
  "name": "@justanarthur/modo-ui-notch",
  "type": "module",
  "version": "0.4.1",
  "description": "A macOS notch app kit on modo-ui: the island that grows out of the notch (idle, compact, split, expanded, flash), its tabs across the wings and the pieces its activities show. Documented with modo.",
  "license": "MIT",
  "keywords": [
    "design-system",
    "react",
    "components",
    "notch",
    "dynamic-island",
    "macos",
    "modo-ui"
  ],
  "homepage": "https://justanarthur.github.io/modo/notch/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/justAnArthur/modo.git",
    "directory": "kits/notch"
  },
  "bugs": {
    "url": "https://github.com/justAnArthur/modo/issues"
  },
  "author": {
    "name": "justAnArthur",
    "email": "kozubov.arthur@gmail.com"
  },
  "properties": {
    "gitCommitScopeRelatedNames": "notch,modo-ui-notch,@justanarthur/modo-ui-notch,justanarthur/modo-ui-notch"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "files": [
    "dist",
    "index.ts",
    "lib/*.ts",
    "lib/*.tsx",
    "components",
    "blocks",
    "mock",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "source": "./index.ts",
      "default": "./dist/index.js"
    },
    "./components/*": {
      "types": "./dist/components/*/index.d.ts",
      "source": "./components/*/index.tsx",
      "default": "./dist/components/*/index.js"
    },
    "./blocks/*": {
      "types": "./dist/blocks/*/index.d.ts",
      "source": "./blocks/*/index.tsx",
      "default": "./dist/blocks/*/index.js"
    },
    "./lib/geometry": {
      "types": "./dist/lib/geometry.d.ts",
      "source": "./lib/geometry.ts",
      "default": "./dist/lib/geometry.js"
    },
    "./lib/island-context": {
      "types": "./dist/lib/island-context.d.ts",
      "source": "./lib/island-context.tsx",
      "default": "./dist/lib/island-context.js"
    },
    "./lib/artwork": {
      "types": "./dist/lib/artwork.d.ts",
      "source": "./lib/artwork.ts",
      "default": "./dist/lib/artwork.js"
    },
    "./lib/clock": {
      "types": "./dist/lib/clock.d.ts",
      "source": "./lib/clock.ts",
      "default": "./dist/lib/clock.js"
    },
    "./lib/motion": {
      "types": "./dist/lib/motion.d.ts",
      "source": "./lib/motion.ts",
      "default": "./dist/lib/motion.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && NODE_ENV=production bunup && bun scripts/build-css.ts",
    "build:docs": "modo build --out docs-dist",
    "dev": "modo dev",
    "check": "tsc --noEmit",
    "check:dist": "bun scripts/check-dist.ts"
  },
  "dependencies": {
    "lucide-react": "^1.47.0",
    "motion": "^13.4.0"
  },
  "peerDependencies": {
    "@justanarthur/modo-ui": "^2.1.0",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@justanarthur/modo": "workspace:*",
    "@justanarthur/modo-ui": "workspace:*",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "bunup": "^0.16.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "typescript": "^5.4.0",
    "unocss": "66.10.5",
    "vite": "^8.3.8"
  }
}