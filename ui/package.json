  "typesVersions": {
    "*": {
      "primitives/*": [
        "dist/primitives/*/index.d.ts"
      ],
      "components/*/variants": [
        "dist/components/*/variants.d.ts"
      ],
      "components/*": [
        "dist/components/*/index.d.ts"
      ],
      "blocks/*/variants": [
        "dist/blocks/*/variants.d.ts"
      ],
      "blocks/*": [
        "dist/blocks/*/index.d.ts"
      ],
      "lib/*": [
        "dist/lib/*.d.ts"
      ],
      "unocss": [
        "dist/preset.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "bun scripts/exports.ts && rm -rf dist && NODE_ENV=production bunup && bun scripts/use-client.ts && bun scripts/build-css.ts",
    "build:docs": "modo build --out docs-dist",
    "dev": "modo dev",
    "check": "tsc --noEmit",
    "check:dist": "bun scripts/check-singletons.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.4.1",
    "@fontsource-variable/inter": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.47.0",
    "motion": "^13.4.0",
    "pdfjs-dist": "^5.7.284",
    "react-day-picker": "^10.0.2",
    "sugar-high": "^2.5.1"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
